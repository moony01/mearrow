# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated files (prebuild)
src/generated/
public/api/news-content/
public/api/auditions-content/

# OpenNext build output
.open-next/
nextImageExportOptimizer/
next-image-export-optimizer-hashes.json

# Wrangler local overrides/secrets
.wrangler/
wrangler.local.jsonc
wrangler.jsonc.local
*.bak.old

# Internal planning/agent files
.claude/

# Local git worktrees
.worktrees/

# Supabase CLI local link metadata (may contain connection details)
supabase/.temp/
