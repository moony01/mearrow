{
  "name": "mearrow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "generate:content": "node scripts/generate-news-json.js && node scripts/generate-auditions-json.js",
    "predev": "pnpm generate:content",
    "dev": "next dev",
    "prebuild": "pnpm generate:content",
    "check:deploy-env": "node scripts/check-deploy-env.mjs",
    "clean:build": "node -e \"const fs=require('fs'); for (const dir of ['.next','out']) fs.rmSync(dir,{recursive:true,force:true});\"",
    "build": "pnpm clean:build && next build && node scripts/postbuild.mjs",
    "pages:build:production": "pnpm check:deploy-env && pnpm test:browser:deploy && pnpm build",
    "workers:build": "node scripts/build-workers.mjs",
    "workers:deploy:production": "pnpm check:deploy-env && pnpm workers:build && pnpm exec opennextjs-cloudflare deploy --env production",
    "start": "next start",
    "lint": "eslint",
    "pretest": "pnpm generate:content",
    "test": "vitest",
    "test:browser:news-popup": "node scripts/news-popup-browser-smoke.mjs",
    "test:browser:workers-auditions": "node scripts/workers-auditions-browser-smoke.mjs",
    "test:browser:deploy": "pnpm check:deploy-env && node scripts/deploy-browser-smoke.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.1",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "classnames": "^2.5.1",
    "framer-motion": "^12.24.12",
    "gray-matter": "^4.0.3",
    "isomorphic-dompurify": "3.0.0-rc.2",
    "lucide-react": "^0.562.0",
    "next": "16.2.11",
    "next-image-export-optimizer": "^1.20.1",
    "next-intl": "^4.7.0",
    "next-themes": "^0.4.6",
    "playwright-core": "^1.58.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.70.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.6.0",
    "remark-gfm": "^4.0.1",
    "sass": "^1.97.2",
    "swr": "^2.3.8",
    "uuid": "^13.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jsdom": "^27.4.0",
    "sharp": "^0.34.5",
    "typescript": "^5",
    "vitest": "^4.0.17",
    "wrangler": "^4.125.0"
  }
}
